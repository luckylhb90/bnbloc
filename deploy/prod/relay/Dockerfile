# GENERATED by deploy/prod/gen-dockerfiles.sh from /Dockerfile — DO NOT EDIT.
# bnbloc relay image with SERVICE (and WEBUI) defaulted, for CI that builds
# a Dockerfile path with no build args:
#   docker build -f deploy/prod/relay/Dockerfile -t bnbloc-relay .

# bnbloc service image — the ONE Dockerfile for every Go service.
#
# SERVICE selects which services/<name>/cmd to compile (SERVICE=cli builds the
# operator CLI, ./cmd/bnbloc, e.g. for the scheduled in-cluster smoke); WEBUI
# selects whether the SPA is built in (only the gateway serves it):
#
#   docker build --build-arg SERVICE=gateway --build-arg WEBUI=full -t bnbloc-gateway .
#   docker build --build-arg SERVICE=room -t bnbloc-room .
#   docker build --build-arg SERVICE=cli -t bnbloc-cli .
#
# deploy/prod/<service>/Dockerfile are GENERATED from this file with those two
# args defaulted (for CI that builds a Dockerfile path with no build args):
# edit this file, then run deploy/prod/gen-dockerfiles.sh. scripts/ci.sh fails
# when the generated copies drift.
#
# Base images are pinned by version + distro release; bump them here.
ARG GO_VERSION=1.24
ARG NODE_VERSION=22
ARG ALPINE_VERSION=3.22
# Selects which webui stage feeds the Go build: `full` builds the SPA, `none`
# (default) supplies a placeholder. Must be declared before the first FROM to
# be usable in a stage reference.
ARG WEBUI=none

# The SPA is built here rather than committed. Only the gateway embeds it, so
# WEBUI=none (the default) selects the placeholder stage and the other
# services never pay for a Node toolchain.
FROM node:${NODE_VERSION}-alpine${ALPINE_VERSION} AS web-full
WORKDIR /web
# pnpm 10 aborts non-interactively when a dependency ships an untrusted build
# script, and the check fires on `build` as well as `install`, so the setting
# is applied to the whole stage rather than passed per-command.
RUN corepack enable
COPY web/package.json web/pnpm-lock.yaml ./
RUN pnpm config set ignore-scripts true && pnpm install --frozen-lockfile
COPY web/ ./
# Build identity for the UI's version stamp: the product version comes from the
# desktop package (vite.config.ts reads ../apps/desktop/package.json); .git is
# not in the build context, so the commit arrives as a build arg.
COPY apps/desktop/package.json /apps/desktop/package.json
ARG CI_COMMIT_SHA=""
ENV CI_COMMIT_SHA=${CI_COMMIT_SHA}
# vite.config.ts writes to ../services/gateway/webui/static, which does not
# exist in this stage's flat layout; retarget it at /out.
RUN sed -i 's#\.\./services/gateway/webui/static#/out/services/gateway/webui/static#' vite.config.ts \
    && pnpm build

# //go:embed static/* fails to compile against a missing directory, so every
# non-gateway build still needs the path to exist.
FROM alpine:${ALPINE_VERSION} AS web-none
RUN mkdir -p /out/services/gateway/webui/static \
    && printf '<!doctype html><title>bnbloc</title>' > /out/services/gateway/webui/static/index.html

FROM web-${WEBUI} AS webui

FROM golang:${GO_VERSION}-alpine${ALPINE_VERSION} AS build
ARG SERVICE=relay
# GO_TAGS selects optional build tags (empty by default). Deployments that
# include tag-gated features pass them here, e.g. GO_TAGS=internal.
ARG GO_TAGS=""
WORKDIR /src
# Allow overriding the module proxy so builds work behind networks where the
# default proxy.golang.org is slow/unreachable (pass --build-arg GOPROXY=...).
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY}
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=webui /out/services/gateway/webui/static ./services/gateway/webui/static
RUN test -n "${SERVICE}" || { echo "build arg SERVICE is required (e.g. gateway, room, realtime)"; exit 1; }
# Build identity (internal/buildinfo, served at /version): .git is not in the
# build context, so the commit arrives as a build arg; the build time is
# taken here. CI_COMMIT_SHA is the build platform's predefined commit variable
# (injected as a build arg); a manual build passes
# --build-arg CI_COMMIT_SHA=$(git rev-parse HEAD).
ARG CI_COMMIT_SHA=""
RUN case "${SERVICE}" in cli) pkg=./cmd/bnbloc ;; *) pkg="./services/${SERVICE}/cmd" ;; esac; \
    bi=github.com/luckylhb90/bnbloc/internal/buildinfo; \
    ldflags="-X $bi.Commit=${CI_COMMIT_SHA} -X $bi.BuiltAt=$(date -u +%Y-%m-%dT%H:%M:%SZ)"; \
    CGO_ENABLED=0 go build -trimpath -tags "${GO_TAGS}" -ldflags "$ldflags" -o /out/bin/bnbloc "$pkg" \
    && CGO_ENABLED=0 go build -trimpath -o /out/bin/healthcheck ./deploy/healthcheck
# Writable state dir for the nonroot user. A named volume mounted here is
# initialised from the image, so it inherits this ownership; without it Docker
# creates a root-owned mount point the nonroot service cannot write.
RUN mkdir -p /out/state/attachments

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/bin/ /usr/local/bin/
COPY --from=build --chown=65532:65532 /out/state/ /var/lib/bnbloc/
# Realtime's disk blob store (attachments + sidecar artifacts); mount a volume
# here to persist, or set BNBLOC_ATTACHMENTS_S3_BUCKET. Other services ignore it.
ENV BNBLOC_ATTACHMENTS_DIR=/var/lib/bnbloc/attachments
USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/bnbloc"]
