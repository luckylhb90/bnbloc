    {
      "id": "sel-config-fix",
      "title": "Fix this value",
      "body": "The selected value looks wrong. Say why and correct it.",
      "starter": true,
      "files": {
        "extensions": [
          ".json",
          ".yaml",
          ".yml",
          ".toml",
          ".ini",
          ".cfg",
          ".conf"
        ]
      },
      "selection": [
        "text",
        "block"
