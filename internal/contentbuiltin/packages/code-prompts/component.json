      "starter": true,
      "files": {
        "extensions": [
          ".py",
          ".go",
          ".js",
          ".mjs",
          ".jsx",
          ".ts",
          ".tsx",
          ".java",
          ".kt",
          ".swift",
          ".rs",
          ".c",
          ".h",
