          ".cc",
          ".cpp",
          ".hpp",
          ".cs",
          ".rb",
          ".php",
          ".lua",
          ".sh",
          ".sql",
          ".scala",
          ".r",
          ".pl",
          ".vue",
          ".svelte"
        ]
      },
      "selection": [
        "text",
        "block"
      ]
    },
    {
      "id": "sel-code-bugs",
      "title": "Find bugs in this",
      "body": "Look for bugs and edge cases in the selected code. Say what you find and fix the clear ones.",
      "starter": true,
