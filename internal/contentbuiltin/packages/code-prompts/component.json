{
  "kind": "bnbloc.prompt.package/v1",
  "name": "code-prompts",
  "version": "1.0.0",
  "displayName": "Code and config prompts",
  "description": "Suggested requests for source files and configuration (Python, Go, TypeScript, JSON, YAML…) and for the lines or value a member selects.",
  "category": "general",
  "tags": [
    "files",
    "starters",
    "code"
  ],
  "prompts": [
    {
      "id": "code-explain",
      "title": "Explain this file",
      "body": "Explain what this file does, how it is organised and how its main parts fit together.",
      "starter": true,
      "files": {
        "extensions": [
          ".py",
          ".go",
          ".js",
          ".mjs",
          ".jsx",
          ".ts",
          ".tsx",
          ".java",
          ".kt",
          ".swift",
          ".rs",
          ".c",
          ".h",
          ".cc",
          ".cpp",
          ".hpp",
          ".cs",
          ".rb",
          ".php",
          ".lua",
          ".sh",
          ".sql",
          ".scala",
          ".r",
          ".pl",
          ".vue",
          ".svelte"
        ]
      }
    },
    {
      "id": "code-review",
      "title": "Review this file",
      "body": "Review this file for bugs, unclear code and risky edge cases. List what you find, most serious first, and fix the clear mistakes.",
      "starter": true,
      "files": {
        "extensions": [
          ".py",
          ".go",
          ".js",
          ".mjs",
          ".jsx",
          ".ts",
          ".tsx",
          ".java",
          ".kt",
          ".swift",
          ".rs",
          ".c",
          ".h",
          ".cc",
          ".cpp",
          ".hpp",
          ".cs",
          ".rb",
          ".php",
          ".lua",
          ".sh",
          ".sql",
          ".scala",
          ".r",
          ".pl",
          ".vue",
          ".svelte"
        ]
      }
    },
    {
      "id": "code-tests",
      "title": "Add tests",
      "body": "Add tests for this file's behaviour, in the project's existing test style, and run them.",
      "starter": true,
      "files": {
        "extensions": [
          ".py",
          ".go",
          ".js",
          ".mjs",
          ".jsx",
          ".ts",
          ".tsx",
          ".java",
          ".kt",
          ".swift",
          ".rs",
          ".c",
          ".h",
          ".cc",
          ".cpp",
          ".hpp",
          ".cs",
          ".rb",
          ".php",
          ".lua",
          ".sh",
          ".sql",
          ".scala",
          ".r",
          ".pl",
          ".vue",
          ".svelte"
        ]
      }
    },
    {
      "id": "code-document",
      "title": "Add doc comments",
      "body": "Add short doc comments to the public functions and to any logic that is not obvious. Do not change behaviour.",
      "starter": true,
      "files": {
        "extensions": [
          ".py",
          ".go",
          ".js",
          ".mjs",
          ".jsx",
          ".ts",
          ".tsx",
          ".java",
          ".kt",
          ".swift",
          ".rs",
          ".c",
          ".h",
          ".cc",
          ".cpp",
          ".hpp",
          ".cs",
          ".rb",
          ".php",
          ".lua",
          ".sh",
          ".sql",
          ".scala",
          ".r",
          ".pl",
          ".vue",
          ".svelte"
        ]
      }
    },
    {
      "id": "sel-code-explain",
      "title": "Explain this code",
      "body": "Explain the selected code: what it does, why it is written this way, and anything surprising.",
      "starter": true,
      "files": {
        "extensions": [
          ".py",
          ".go",
          ".js",
          ".mjs",
          ".jsx",
          ".ts",
          ".tsx",
          ".java",
          ".kt",
          ".swift",
          ".rs",
