    {
      "id": "config-explain",
      "title": "Explain this file",
      "body": "Explain what this file is for and what each top-level setting does.",
      "starter": true,
      "files": {
        "extensions": [
          ".json",
          ".yaml",
          ".yml",
          ".toml",
          ".ini",
          ".cfg",
          ".conf"
        ]
      }
    },
    {
      "id": "config-check",
      "title": "Check for mistakes",
      "body": "Check this file for mistakes: wrong types, missing or unknown keys, inconsistent values. Fix the clear ones and list the rest.",
      "starter": true,
      "files": {
        "extensions": [
          ".json",
          ".yaml",
          ".yml",
          ".toml",
          ".ini",
          ".cfg",
          ".conf"
        ]
      }
    },
    {
      "id": "config-tidy",
      "title": "Tidy it",
      "body": "Tidy this file: consistent formatting and a sensible order of keys. Keep every value and comment.",
      "starter": true,
      "files": {
        "extensions": [
          ".json",
          ".yaml",
          ".yml",
          ".toml",
          ".ini",
          ".cfg",
          ".conf"
        ]
      }
    },
    {
      "id": "sel-config-explain",
      "title": "Explain this value",
      "body": "Explain the selected setting or value: what it controls and what is safe to change.",
      "starter": true,
      "files": {
        "extensions": [
          ".json",
          ".yaml",
          ".yml",
          ".toml",
          ".ini",
          ".cfg",
          ".conf"
