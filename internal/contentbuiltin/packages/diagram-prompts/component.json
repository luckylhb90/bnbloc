{
  "kind": "bnbloc.prompt.package/v1",
  "name": "diagram-prompts",
  "version": "1.0.0",
  "displayName": "Diagram prompts",
  "description": "Suggested requests for Mermaid, draw.io and SVG files and for the box, arrow or area a member points at.",
  "category": "general",
  "tags": [
    "files",
    "starters",
    "diagrams"
  ],
  "prompts": [
    {
      "id": "dg-explain",
      "title": "Explain this diagram",
      "body": "Explain this diagram step by step: what it shows, how its parts connect, and anything unclear or missing.",
      "starter": true,
      "files": {
        "extensions": [
          ".mmd",
          ".mermaid",
          ".drawio",
          ".dio"
        ],
        "mimeTypes": [
          "text/vnd.mermaid",
          "application/vnd.jgraph.mxfile"
        ]
      }
    },
    {
      "id": "dg-simplify",
      "title": "Simplify it",
      "body": "Simplify this diagram: merge or remove steps that add nothing. Keep the meaning and the style.",
      "starter": true,
      "files": {
        "extensions": [
          ".mmd",
          ".mermaid",
          ".drawio",
          ".dio"
        ],
        "mimeTypes": [
          "text/vnd.mermaid",
          "application/vnd.jgraph.mxfile"
        ]
      }
    },
    {
      "id": "dg-gaps",
      "title": "Check for gaps",
      "body": "Check the diagram for gaps: dead ends, missing branches, steps with no owner. List them and fix the clear ones.",
      "starter": true,
      "files": {
        "extensions": [
          ".mmd",
          ".mermaid",
          ".drawio",
          ".dio"
        ],
        "mimeTypes": [
          "text/vnd.mermaid",
          "application/vnd.jgraph.mxfile"
        ]
      }
    },
    {
      "id": "dg-layout",
      "title": "Tidy the layout",
      "body": "Tidy the layout: align the boxes, even out the spacing, avoid crossing lines. Keep the content as it is.",
      "starter": true,
      "files": {
        "extensions": [
          ".mmd",
          ".mermaid",
          ".drawio",
          ".dio"
        ],
        "mimeTypes": [
          "text/vnd.mermaid",
          "application/vnd.jgraph.mxfile"
        ]
      }
    },
    {
      "id": "dg-to-mermaid",
      "title": "Turn it into Mermaid",
      "body": "Write this diagram as a Mermaid file next to it, with the same steps and labels.",
      "starter": true,
      "files": {
        "extensions": [
          ".drawio",
          ".dio"
        ],
        "mimeTypes": [
          "application/vnd.jgraph.mxfile"
        ]
      }
    },
    {
      "id": "dg-to-drawio",
      "title": "Turn it into draw.io",
      "body": "Write this diagram as a draw.io file next to it, with the same steps and labels.",
      "starter": true,
      "files": {
        "extensions": [
          ".mmd",
          ".mermaid"
        ],
        "mimeTypes": [
          "text/vnd.mermaid"
        ]
      }
    },
    {
      "id": "sel-dg-rename",
      "title": "Rename this",
      "body": "Rename the selected part to: ",
      "starter": true,
      "files": {
        "extensions": [
          ".mmd",
          ".mermaid",
          ".drawio",
          ".dio"
        ],
        "mimeTypes": [
          "text/vnd.mermaid",
          "application/vnd.jgraph.mxfile"
        ]
      },
      "selection": [
        "block",
        "text"
      ]
    },
    {
      "id": "sel-dg-add",
      "title": "Add a step after this",
      "body": "Add a new step after the selected part: ",
      "starter": true,
      "files": {
        "extensions": [
          ".mmd",
          ".mermaid",
          ".drawio",
          ".dio"
        ],
        "mimeTypes": [
          "text/vnd.mermaid",
          "application/vnd.jgraph.mxfile"
        ]
      },
      "selection": [
        "block",
        "text"
      ]
    },
    {
      "id": "sel-dg-remove",
      "title": "Remove this",
      "body": "Remove the selected part and reconnect what was linked to it.",
      "starter": true,
      "files": {
        "extensions": [
          ".mmd",
          ".mermaid",
          ".drawio",
          ".dio"
        ],
        "mimeTypes": [
          "text/vnd.mermaid",
          "application/vnd.jgraph.mxfile"
        ]
      },
      "selection": [
        "block",
        "text"
      ]
    },
    {
      "id": "sel-dg-color",
      "title": "Recolor this",
      "body": "Change the color of the selected part to: ",
      "starter": true,
      "files": {
        "extensions": [
          ".mmd",
          ".mermaid",
          ".drawio",
          ".dio"
        ],
        "mimeTypes": [
          "text/vnd.mermaid",
          "application/vnd.jgraph.mxfile"
        ]
      },
      "selection": [
        "block",
        "text"
      ]
    },
    {
      "id": "sel-dg-explain",
      "title": "Explain this part",
      "body": "Explain what the selected part does in the flow and how it connects to the rest.",
      "starter": true,
      "files": {
        "extensions": [
          ".mmd",
          ".mermaid",
          ".drawio",
          ".dio"
        ],
        "mimeTypes": [
          "text/vnd.mermaid",
          "application/vnd.jgraph.mxfile"
        ]
      },
      "selection": [
        "block",
        "text"
      ]
    },
    {
      "id": "svg-tidy",
      "title": "Tidy the SVG",
      "body": "Clean up this SVG: remove unused groups and attributes, keep how it looks.",
      "starter": true,
      "files": {
        "extensions": [
          ".svg"
        ],
        "mimeTypes": [
          "image/svg+xml"
        ]
      }
    },
    {
      "id": "svg-accessible",
      "title": "Make it accessible",
      "body": "Add a title and a description, and make sure the text has enough contrast.",
      "starter": true,
      "files": {
        "extensions": [
          ".svg"
        ],
        "mimeTypes": [
          "image/svg+xml"
        ]
      }
    },
    {
      "id": "sel-svg-relabel",
      "title": "Relabel this",
      "body": "Change the text in the selected area to: ",
      "starter": true,
      "files": {
        "extensions": [
          ".svg"
        ],
        "mimeTypes": [
          "image/svg+xml"
        ]
      },
      "selection": [
        "region"
      ]
    },
    {
      "id": "sel-svg-color",
      "title": "Recolor this",
      "body": "Change the color of what is in the selected area to: ",
      "starter": true,
      "files": {
        "extensions": [
          ".svg"
        ],
        "mimeTypes": [
          "image/svg+xml"
        ]
      },
      "selection": [
        "region"
      ]
    },
    {
      "id": "sel-svg-remove",
      "title": "Remove this",
      "body": "Remove what is in the selected area.",
      "starter": true,
      "files": {
        "extensions": [
          ".svg"
        ],
        "mimeTypes": [
          "image/svg+xml"
        ]
      },
      "selection": [
        "region"
      ]
    },
    {
      "id": "sel-svg-explain",
      "title": "Explain this part",
      "body": "Explain what the selected area shows and how it relates to the rest of the drawing.",
      "starter": true,
      "files": {
        "extensions": [
          ".svg"
        ],
        "mimeTypes": [
          "image/svg+xml"
        ]
      },
      "selection": [
        "region"
      ]
    }
  ]
}
