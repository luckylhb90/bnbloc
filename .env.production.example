# Production environment template for the bnbloc stack.
# Copy this to `.env.production` (gitignored), fill each CHANGE-ME, and never
# commit real credentials. For AWS Secrets Manager, set BNBLOC_AWS_SECRET_ID
# (+ BNBLOC_AWS_REGION) and omit the secret-bearing values here.
#
# deploy/compose.prod.yml sets BNBLOC_ENV=production on every service, so any
# value below marked REQUIRED that is still empty after the secrets load stops
# that service at startup instead of letting it boot in dev mode.
# Full reference: docs/environment-variables.md.

# --- Storage (REQUIRED) --------------------------------------------------
# MySQL 8. Create the database first; the services apply the schema
# themselves at start (deploy/schema.sql for a fresh database, ordered
# migrations through the schema_migrations ledger for an existing one), so the
# account needs CREATE, ALTER and INDEX in addition to DML. One DSN is shared
# by every service. multiStatements is added by the code; append &tls=true for
# a managed instance.
BNBLOC_MYSQL_DSN=bnbloc:CHANGE-ME@tcp(mysql.internal.example.com:3306)/bnbloc?parseTime=true

# --- Service-to-service authentication (REQUIRED) ------------------------
# Signs the X-Bnbloc-User header between services. Identical everywhere.
BNBLOC_INTERNAL_KEY=CHANGE-ME

# --- Session tokens (REQUIRED) -------------------------------------------
# Signs browser session JWTs. Leaking it allows forging any identity;
# rotating it logs everyone out.
BNBLOC_SESSION_SIGNING_KEY=<generate-a-random-key>

# --- Identity provider (REQUIRED) ----------------------------------------
# OIDC relying party. With BNBLOC_ENV=production the gateway refuses to start
# without both (the dev verifier accepts ANY identity string).
BNBLOC_OIDC_ISSUER_URL=https://idp.example.com
BNBLOC_OIDC_CLIENT_ID=CHANGE-ME

# Cross-tenant platform admins: comma-separated VERIFIED subject ids or emails
# as issued by your IdP. The dev default "root" must not survive into
# production.
BNBLOC_SUPER_ADMINS=CHANGE-ME@example.com

# --- Optional ------------------------------------------------------------
# Shared bearer a trusted local daemon may present to the gateway. Empty
# disables that path (fail closed); desktop bridges sign in as their member
# and need no shared token.
BNBLOC_LOCAL_AGENT_TOKEN=

# Extra browser origins allowed for cross-origin API calls (comma-separated).
# Same-origin browser clients and the desktop app need nothing here.
BNBLOC_ALLOWED_ORIGINS=

# Member notifications (docs/notifications.md): the public web origin room
# deep links use (e.g. https://bnbloc.example.com). Delivery goes to installed
# notifier components; BNBLOC_INTERNAL_KEY also encrypts members' personal
# notifier secrets (rotating it makes members re-enter them).
BNBLOC_PUBLIC_URL=

# Browser push notifications (optional): a VAPID key pair from
# `bnbloc keys gen-vapid`. Empty = the channel is off and the web hides its
# toggle. SUBJECT is mailto:<ops address>; empty uses an https
# BNBLOC_PUBLIC_URL. Keep the private key secret.
BNBLOC_WEB_PUSH_VAPID_PUBLIC_KEY=
BNBLOC_WEB_PUSH_VAPID_PRIVATE_KEY=
BNBLOC_WEB_PUSH_VAPID_SUBJECT=

# Attachments / sidecar artifacts: empty bucket = the realtime disk volume.
BNBLOC_ATTACHMENTS_S3_BUCKET=
BNBLOC_ATTACHMENTS_S3_REGION=
BNBLOC_ATTACHMENTS_S3_ENDPOINT=
BNBLOC_ATTACHMENTS_S3_KEY_PREFIX=
# Direct downloads (S3 only): 302 to a short-lived presigned URL instead of
# streaming through bnbloc. PUBLIC_ENDPOINT = the S3 base URL clients reach
# (empty = BNBLOC_ATTACHMENTS_S3_ENDPOINT).
BNBLOC_ATTACHMENTS_S3_DIRECT_DOWNLOADS=false
BNBLOC_ATTACHMENTS_S3_PUBLIC_ENDPOINT=

# Nightly smoke (optional; the profile-gated `smoke` service, run by the
# host's cron — docs/production-deployment.md#nightly-smoke). The token is
# from `bnbloc api-tokens create --subject svc:smoke` (list svc:smoke in
# BNBLOC_SUPER_ADMINS). Gateway default: the gateway container.
BNBLOC_SMOKE_API_TOKEN=
BNBLOC_SMOKE_GATEWAY=
BNBLOC_SMOKE_AGENT=
BNBLOC_SMOKE_ALERT_TO=

# --- Agent cores ---------------------------------------------------------
# No core is configured here: a super-admin installs signed core packages
# (Platform → Components, or `bnbloc cores install`), which persist in the
# database and rehydrate at boot. BNBLOC_CORES is only an operator escape
# hatch for an explicitly addressed core (each then needs a reachable
# BNBLOC_CORE_<NAME>_URL). Leave empty.
BNBLOC_CORES=
