{
  "kind": "bnbloc.plugin.package/v1",
  "contract": "bnbloc.plugin.contract/v1",
  "name": "local-skills",
  "version": "0.1.0",
  "publisher": "bnbloc",
  "description": "Choose which skill folders on your computer reach your agents' sandbox and your library. Nothing is shared until you turn it on.",
  "runtime": "sidecar",
  "capabilities": ["skills-provider", "sandbox-mounts"],
  "sidecar": {
    "localUrl": "http://127.0.0.1:7192",
    "listenEnv": "BNBLOC_LOCAL_SKILLS_LISTEN_URL",
    "supervisedEnv": "BNBLOC_LOCAL_SKILLS_SUPERVISED",
    "tokenEnv": "BNBLOC_LOCAL_SKILLS_TOKEN",
    "dataDirEnv": "BNBLOC_LOCAL_SKILLS_DATA_DIR",
    "mountsEnv": "BNBLOC_LOCAL_SKILLS_MOUNTS_FILE",
    "mountRootEnv": "BNBLOC_LOCAL_SKILLS_MOUNT_ROOT"
  }
}
