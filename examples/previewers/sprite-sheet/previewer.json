{
  "kind": "bnbloc.previewer.package/v1",
  "contract": "bnbloc.previewer.contract/v1",
  "runtime": "bundle",
  "name": "sprite-sheet",
  "version": "1.0.0",
  "publisher": "bnbloc-examples",
  "description": "Reference previewer: images and sprite-sheet / texture-atlas JSON with zoom, fit, grid, checkerboard and frame-boundary layers.",
  "artifacts": {
    "bundle": { "url": "", "sha256": "" }
  },
  "previewer": {
    "entry": "index.html",
    "match": {
      "mimeTypes": ["image/png", "image/gif", "image/webp", "image/jpeg"],
      "extensions": [".png", ".gif", ".webp", ".jpg", ".jpeg", ".atlas.json", ".spritesheet.json"]
    },
    "rank": 50,
    "capabilities": ["thumbnail", "liveState", "toolbar"],
    "toolbar": [
      { "id": "zoom", "icon": "zoom-in", "label": "Zoom", "kind": "zoom" },
      { "id": "fit", "icon": "fit", "label": "Fit to view", "kind": "button" },
      { "id": "grid", "icon": "grid", "label": "Grid", "kind": "toggle" },
      { "id": "background", "icon": "background", "label": "Checkerboard", "kind": "toggle" },
      { "id": "frames", "icon": "frames", "label": "Frame boundaries", "kind": "toggle" }
    ]
  }
}
