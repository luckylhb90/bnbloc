{
  "kind": "bnbloc.previewer.package/v1",
  "contract": "bnbloc.previewer.contract/v1",
  "runtime": "bundle",
  "name": "xlsx",
  "version": "1.3.0",
  "publisher": "bnbloc",
  "description": "Excel workbooks (.xlsx, .xlsm, .xltx): every sheet drawn in place — formatted values, fonts, fills, borders, merged cells — with sheet tabs and zoom.",
  "artifacts": {
    "bundle": { "url": "", "sha256": "" }
  },
  "previewer": {
    "entry": "index.html",
    "match": {
      "mimeTypes": [
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "application/vnd.ms-excel.sheet.macroenabled.12",
        "application/vnd.openxmlformats-officedocument.spreadsheetml.template"
      ],
      "extensions": [".xlsx", ".xlsm", ".xltx"]
    },
    "rank": 50,
    "capabilities": ["toolbar", "selection", "units"],
    "toolbar": [{ "id": "zoom", "icon": "zoom-in", "label": "Zoom", "kind": "zoom" }]
  }
}
