{
  "kind": "bnbloc.previewer.package/v1",
  "contract": "bnbloc.previewer.contract/v1",
  "runtime": "bundle",
  "name": "pptx",
  "version": "1.4.0",
  "publisher": "bnbloc",
  "description": "PowerPoint decks (.pptx, .pptm, .ppsx, .potx): every slide rendered in place — text, shapes, images, tables, charts — with zoom and fit.",
  "artifacts": {
    "bundle": { "url": "", "sha256": "" }
  },
  "previewer": {
    "entry": "index.html",
    "match": {
      "mimeTypes": [
        "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "application/vnd.ms-powerpoint.presentation.macroenabled.12",
        "application/vnd.openxmlformats-officedocument.presentationml.slideshow",
        "application/vnd.openxmlformats-officedocument.presentationml.template"
      ],
      "extensions": [".pptx", ".pptm", ".ppsx", ".potx"]
    },
    "rank": 50,
    "capabilities": ["thumbnail", "toolbar", "selection", "units"],
    "toolbar": [
      { "id": "zoom", "icon": "zoom-in", "label": "Zoom", "kind": "zoom" },
      { "id": "fit", "icon": "fit", "label": "Fit to width", "kind": "button" }
    ]
  }
}
