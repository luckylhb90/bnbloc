{
  "kind": "bnbloc.previewer.package/v1",
  "contract": "bnbloc.previewer.contract/v1",
  "runtime": "bundle",
  "name": "drawio",
  "version": "1.1.0",
  "publisher": "bnbloc",
  "description": "draw.io diagrams (.drawio, .dio): every page drawn in place with its shapes, connectors and labels, page tabs and zoom; point at a box or an arrow to ask about it.",
  "artifacts": {
    "bundle": { "url": "", "sha256": "" }
  },
  "previewer": {
    "entry": "index.html",
    "match": {
      "mimeTypes": ["application/vnd.jgraph.mxfile", "application/x-drawio"],
      "extensions": [".drawio", ".dio"]
    },
    "rank": 50,
    "capabilities": ["thumbnail", "toolbar", "selection", "units"],
    "toolbar": [
      { "id": "zoom", "icon": "zoom-in", "label": "Zoom", "kind": "zoom" },
      { "id": "fit", "icon": "fit", "label": "Fit to view", "kind": "button" }
    ]
  }
}
