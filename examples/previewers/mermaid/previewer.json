{
  "kind": "bnbloc.previewer.package/v1",
  "contract": "bnbloc.previewer.contract/v1",
  "runtime": "bundle",
  "name": "mermaid",
  "version": "1.1.0",
  "publisher": "bnbloc",
  "description": "Mermaid diagrams (.mmd, .mermaid): flowcharts, sequence, class, state, ER, Gantt and more, drawn from their source, with zoom, parse errors shown with their line, and a click on a box naming it for the Ask AI panel.",
  "artifacts": {
    "bundle": { "url": "", "sha256": "" }
  },
  "previewer": {
    "entry": "index.html",
    "match": {
      "mimeTypes": ["text/vnd.mermaid"],
      "extensions": [".mmd", ".mermaid"]
    },
    "rank": 50,
    "capabilities": ["thumbnail", "toolbar", "selection", "units"],
    "toolbar": [
      { "id": "zoom", "icon": "zoom-in", "label": "Zoom", "kind": "zoom" },
      { "id": "fit", "icon": "fit", "label": "Fit to view", "kind": "button" }
    ]
  }
}
