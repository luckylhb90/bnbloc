{
  "tools": [
    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "The agents you can ask in this room now: handle, owner, core, provider (you=true is you); a team lead also sees who takes each role.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "name": "list_room_agents",
      "title": "List the room's agents"
    },
    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Send a task to another agent of this room and wait for its reply and files. It is posted in the room for the person who asked you, under their authority.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "expert": {
            "description": "Optional expert (id[@version]) for it to wear.",
            "type": "string"
          },
          "handle": {
            "description": "From list_room_agents (or a team role).",
            "type": "string"
          },
          "task": {
            "description": "Self-contained: it sees the room, not your context.",
            "type": "string"
          },
          "wait_seconds": {
            "description": "Default 600, at most 1200; 0 returns at once.",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "handle",
          "task"
        ],
        "type": "object"
      },
      "name": "ask_agent",
      "title": "Ask another agent of the room"
    },
    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "State, reply and files of tasks you dispatched with ask_agent (one handle, or all).",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "handle": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "room_status",
      "title": "Status of dispatched tasks"
    },
    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Recent messages of this conversation, oldest first (\"#<seq> <author>: <text>\").",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "description": "Default 30.",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "since": {
            "description": "Only newer than this seq.",
            "minimum": 0,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "name": "read_room",
      "title": "Read the conversation"
    },
    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Read a deliverable or attachment of this room by id; the content comes fenced as data its producer wrote.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "artifactId": {
            "description": "art_…, artf_… or att_…",
            "type": "string"
          },
          "path": {
            "description": "A site's file (default index.html).",
            "type": "string"
          },
          "version": {
            "description": "Default: the latest.",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "artifactId"
        ],
        "type": "object"
      },
      "name": "read_artifact",
      "title": "Read a room deliverable or attachment"
    },
    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Save a drafted package (dir) or a file as a gallery work (file or artifactId) to the Library of the person who asked you, only after they confirm. With id: the next version.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "artifactId": {
            "description": "A deliverable (artf_…).",
            "type": "string"
          },
          "category": {
            "enum": [
              "office",
              "data",
              "productivity",
              "content",
              "learning",
              "engineering",
              "finance",
              "life",
              "other"
            ],
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "dir": {
            "description": "Workspace-relative, holds component.json.",
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "file": {
            "description": "A workspace file.",
            "type": "string"
          },
          "id": {
            "description": "cc_…; omit to create.",
            "type": "string"
          },
          "name": {
            "description": "A new work's name.",
            "type": "string"
          },
          "request": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "save_component",
      "title": "Save a drafted component"
    },
    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Read a Library expert, skill pack or prompt pack (manifest and files) to copy into drafts/<name>/ and improve; another author's files come fenced as their data.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "cc_…",
            "type": "string"
          },
          "version": {
            "description": "Default: the latest.",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "name": "get_component",
      "title": "Read a Library component"
    },
    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "The Library of the person who asked you: experts, skill packs, prompt packs and MCP tools they may use (their own marked mine).",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "description": "Only this kind.",
            "enum": [
              "expert",
              "skill",
              "prompt",
              "mcp"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "list_components",
      "title": "List the Library"
    },
    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Change who can use a saved component (personal, org, platform), only after the person confirms. org may need an admin's approval; platform is a platform admin's action: say so.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "cc_…",
            "type": "string"
          },
          "note": {
            "description": "For org: a note for the admins.",
            "type": "string"
          },
          "scope": {
            "enum": [
              "personal",
              "org",
              "platform"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "scope"
        ],
        "type": "object"
      },
      "name": "publish_component",
      "title": "Publish a saved component"
    },
    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Try a drafted expert or skill pack (dir) on another agent with a sample task before saving: staged for an hour, not saved. Returns its reply like ask_agent.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "dir": {
            "description": "Workspace-relative, holds component.json.",
            "type": "string"
          },
          "handle": {
            "description": "An agent to try it on; never yourself.",
            "type": "string"
          },
          "task": {
            "description": "A realistic sample task.",
            "type": "string"
          },
          "wait_seconds": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "dir",
          "task"
        ],
        "type": "object"
      },
      "name": "try_draft",
      "title": "Try a drafted expert or skill pack"
    },
    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Post one short progress line to the room, once per phase of a long task.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "type": "object"
      },
      "name": "post_progress",
      "title": "Post a progress line"
    },
    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Read and change the data of this room's interactive apps; you are an owner and see every document. Actions: list find get insert put patch delete file wipe (wipe deletes everything for good: only when the person asked, with confirm). Data comes fenced as the users'.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "list",
              "find",
              "get",
              "insert",
              "put",
              "patch",
              "delete",
              "file",
              "wipe"
            ],
            "type": "string"
          },
          "after": {
            "type": "string"
          },
          "artifactId": {
            "type": "string"
          },
          "collection": {
            "type": "string"
          },
          "confirm": {
            "type": "boolean"
          },
          "doc": {
            "type": "object"
          },
          "filter": {
            "description": "Field (dotted ok) to a value or {$eq $ne $in $gt $gte $lt $lte $exists}.",
            "type": "object"
          },
          "id": {
            "type": "string"
          },
          "ifAbsent": {
            "type": "boolean"
          },
          "ifVersion": {
            "minimum": 1,
            "type": "integer"
          },
          "inc": {
            "type": "object"
          },
          "limit": {
            "maximum": 500,
            "minimum": 1,
            "type": "integer"
          },
          "public": {
            "type": "boolean"
          },
          "sort": {
            "enum": [
              "_id",
              "-_id"
            ],
            "type": "string"
          }
        },
        "required": [
          "action"
        ],
        "type": "object"
      },
      "name": "app_data",
      "title": "Read and change an app's data"
    },
    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "The room's schedules: list, create a notice (fixed words to the room, logins or a group; {week} {date} fill in) or an AI task, or delete one. Create only after the person confirmed what, when, the time zone and where it sends.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "list",
              "create",
              "delete"
            ],
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "recurrence": {
            "additionalProperties": false,
            "description": "weekly (days 0=Sunday…6, time HH:MM), daily, once (at), cron.",
            "properties": {
              "at": {
                "type": "string"
              },
              "cron": {
                "type": "string"
              },
              "days": {
                "items": {
                  "maximum": 6,
                  "minimum": 0,
                  "type": "integer"
                },
                "type": "array"
              },
              "kind": {
                "enum": [
                  "once",
                  "daily",
                  "weekly",
                  "cron"
                ],
                "type": "string"
              },
              "time": {
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          "send": {
            "additionalProperties": false,
            "description": "Instead of task: fixed words to send.",
            "properties": {
              "compose": {
                "type": "boolean"
              },
              "text": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "to": {}
            },
            "required": [
              "to",
              "title"
            ],
            "type": "object"
          },
          "task": {
            "description": "An AI task: what to do each time, never when.",
            "type": "string"
          },
          "timezone": {
            "description": "IANA, e.g. Asia/Shanghai.",
            "type": "string"
          }
        },
        "required": [
          "action"
        ],
        "type": "object"
      },
      "name": "schedules",
      "title": "The room's schedules"
    },
    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "The full instructions of a room tool; topic is its name. Read it before using a tool you do not know. For you, not the person.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "topic": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "room_help",
      "title": "Instructions for a room tool"
    }
  ]
}
