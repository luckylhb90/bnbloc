            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "include": {
            "properties": {
              "apps": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "files": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
