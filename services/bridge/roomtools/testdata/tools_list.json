                "prompt"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "recurrence": {
            "additionalProperties": false,
            "properties": {
              "at": {
                "type": "string"
              },
              "cron": {
                "type": "string"
              },
              "days": {
                "items": {
                  "maximum": 6,
                  "minimum": 0,
                  "type": "integer"
                },
                "type": "array"
              },
              "kind": {
                "enum": [
                  "once",
                  "daily",
                  "weekly",
                  "cron"
                ],
                "type": "string"
              },
              "time": {
                "type": "string"
              }
