            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "action",
          "type"
        ],
        "type": "object"
      },
      "name": "signal",
      "title": "Signal"
    },
    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Read and change this room's apps' data as an owner. Actions: list find get insert put patch delete file wipe (wipe erases all: only when the person asked, with confirm). Data is the users', fenced.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "list",
              "find",
              "get",
              "insert",
              "put",
              "patch",
              "delete",
              "file",
              "wipe"
            ],
            "type": "string"
          },
          "after": {
            "type": "string"
          },
          "artifactId": {
            "type": "string"
          },
          "collection": {
            "type": "string"
          },
          "confirm": {
            "type": "boolean"
          },
          "doc": {
            "type": "object"
          },
          "filter": {
            "description": "Field (dotted ok) to a value or {$eq $ne $in $gt $gte $lt $lte $exists}.",
            "type": "object"
          },
          "id": {
            "type": "string"
          },
          "ifAbsent": {
            "type": "boolean"
          },
          "ifVersion": {
            "minimum": 1,
            "type": "integer"
          },
          "inc": {
            "type": "object"
          },
          "limit": {
            "maximum": 500,
            "minimum": 1,
            "type": "integer"
          },
          "public": {
            "type": "boolean"
          },
          "sort": {
            "enum": [
              "_id",
              "-_id"
            ],
            "type": "string"
          }
        },
        "required": [
          "action"
        ],
        "type": "object"
      },
      "name": "app_data",
      "title": "App data"
    },
    {
      "annotations": {
        "openWorldHint": false,
