      "title": "Progress"
    },
    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Tell this room a step is done (its waiting tasks run), for the person who asked you; once, not for progress.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "send"
            ],
            "type": "string"
          },
          "data": {
            "type": "object"
          },
