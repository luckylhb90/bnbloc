          },
          "note": {
            "type": "string"
          },
          "request": {
            "type": "string"
          },
          "scope": {
            "enum": [
              "personal",
              "org",
              "platform"
            ],
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "task": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "wait_seconds": {
            "minimum": 0,
            "type": "integer"
          }
