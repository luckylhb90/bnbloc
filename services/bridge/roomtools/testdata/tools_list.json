{
  "tools": [
    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "The agents you can ask here now (you=true is you); a team lead also sees each role's taker.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "name": "list_room_agents",
      "title": "Room agents"
    },
    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Ask another agent here for the person who asked you, under their authority; get its reply and files.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "expert": {
            "type": "string"
          },
          "handle": {
            "description": "From list_room_agents, or a team role.",
            "type": "string"
          },
          "task": {
            "description": "Self-contained: it sees the room, not your context.",
            "type": "string"
          },
          "wait_seconds": {
            "description": "Default 600, max 1200; 0 returns at once.",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "handle",
          "task"
        ],
        "type": "object"
      },
      "name": "ask_agent",
      "title": "Ask an agent"
    },
    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "State, reply and files of tasks you dispatched with ask_agent (one handle, or all).",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "handle": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "room_status",
      "title": "Dispatched tasks"
    },
    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Recent messages of this conversation, oldest first (\"#<seq> <author>: <text>\").",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "description": "Default 30.",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "since": {
            "description": "Only newer than this seq.",
            "minimum": 0,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "name": "read_room",
      "title": "Conversation"
    },
    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "A deliverable or attachment of this room by id, fenced as its producer's data.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "artifactId": {
            "type": "string"
          },
          "path": {
            "description": "A site's file (default index.html).",
            "type": "string"
          },
          "version": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "artifactId"
        ],
        "type": "object"
      },
      "name": "read_artifact",
      "title": "Room file"
    },
    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": false
