    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Read and change the data of this room's interactive apps; you are an owner and see every document. Actions: list find get insert put patch delete file wipe (wipe deletes everything for good: only when the person asked, with confirm). Data comes fenced as the users'.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "list",
              "find",
              "get",
              "insert",
              "put",
              "patch",
              "delete",
              "file",
              "wipe"
            ],
            "type": "string"
          },
          "after": {
            "type": "string"
          },
          "artifactId": {
            "type": "string"
          },
          "collection": {
            "type": "string"
          },
          "confirm": {
            "type": "boolean"
          },
          "doc": {
            "type": "object"
          },
          "filter": {
            "description": "Field (dotted ok) to a value or {$eq $ne $in $gt $gte $lt $lte $exists}.",
            "type": "object"
          },
          "id": {
            "type": "string"
          },
          "ifAbsent": {
            "type": "boolean"
          },
          "ifVersion": {
            "minimum": 1,
            "type": "integer"
          },
          "inc": {
            "type": "object"
          },
          "limit": {
            "maximum": 500,
            "minimum": 1,
            "type": "integer"
          },
          "public": {
            "type": "boolean"
          },
          "sort": {
            "enum": [
              "_id",
              "-_id"
            ],
            "type": "string"
          }
        },
        "required": [
          "action"
        ],
        "type": "object"
      },
      "name": "app_data",
      "title": "Read and change an app's data"
    },
    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "This room's setup (description, welcome, quick prompts, expert, packs, channels, schedules, sources) as the person who asked you; make a change only after they agree. Actions: get set use unuse add_channel add_schedule remove_schedule ask_source (room_help room_setup).",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "get",
              "set",
              "use",
              "unuse",
              "add_channel",
              "add_schedule",
              "remove_schedule",
              "ask_source"
            ],
            "type": "string"
          },
          "agent": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "expert",
              "skill",
              "prompt"
            ],
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "quickPrompts": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "prompt": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
