            "description": "A site's file (default index.html).",
            "type": "string"
          },
          "version": {
            "description": "Default: the latest.",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "artifactId"
        ],
        "type": "object"
      },
      "name": "read_artifact",
      "title": "Read a room deliverable or attachment"
    },
    {
