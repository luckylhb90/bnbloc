{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bnbloc",
  "version": "../package.json",
  "identifier": "sh.bnbloc.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../../web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --dir ../../web build && node scripts/build-bridge-sidecar.mjs",
    "frontendDist": "../../../services/gateway/webui/static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https: http://localhost:* http://127.0.0.1:*",
        "font-src": "'self' data:",
        "media-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https: wss: http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*",
        "frame-src": "bnbloc-artifact://localhost http://bnbloc-artifact.localhost bnbloc-previewer://localhost http://bnbloc-previewer.localhost bnbloc-site://localhost http://bnbloc-site.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": null,
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/bnbloc-bridge"
    ],
    "category": "DeveloperTool",
    "fileAssociations": [
      { "ext": ["pptx"], "name": "PowerPoint presentation", "contentTypes": ["org.openxmlformats.presentationml.presentation"], "role": "Editor", "rank": "Alternate" },
      { "ext": ["docx"], "name": "Word document", "contentTypes": ["org.openxmlformats.wordprocessingml.document"], "role": "Editor", "rank": "Alternate" },
      { "ext": ["xlsx"], "name": "Excel workbook", "contentTypes": ["org.openxmlformats.spreadsheetml.sheet"], "role": "Editor", "rank": "Alternate" },
      { "ext": ["pdf"], "name": "PDF document", "contentTypes": ["com.adobe.pdf"], "role": "Viewer", "rank": "Alternate" },
      { "ext": ["md", "markdown"], "name": "Markdown document", "contentTypes": ["net.daringfireball.markdown"], "role": "Editor", "rank": "Alternate" },
      { "ext": ["csv"], "name": "CSV table", "contentTypes": ["public.comma-separated-values-text"], "role": "Editor", "rank": "Alternate" },
      { "ext": ["json"], "name": "JSON", "contentTypes": ["public.json"], "role": "Editor", "rank": "Alternate" },
      { "ext": ["txt", "log"], "name": "Text", "contentTypes": ["public.plain-text", "public.log"], "role": "Editor", "rank": "Alternate" },
      { "ext": ["yaml", "yml"], "name": "YAML", "contentTypes": ["public.yaml"], "role": "Editor", "rank": "Alternate" },
      { "ext": ["xml"], "name": "XML", "contentTypes": ["public.xml"], "role": "Editor", "rank": "Alternate" },
      { "ext": ["tsv"], "name": "TSV table", "contentTypes": ["public.tab-separated-values-text"], "role": "Editor", "rank": "Alternate" },
      { "ext": ["html", "htm"], "name": "Web page", "contentTypes": ["public.html"], "role": "Viewer", "rank": "Alternate" },
      { "ext": ["png", "jpg", "jpeg", "gif", "webp", "svg", "bmp", "avif"], "name": "Image", "contentTypes": ["public.png", "public.jpeg", "com.compuserve.gif", "org.webmproject.webp", "public.svg-image", "com.microsoft.bmp", "public.avif"], "role": "Viewer", "rank": "Alternate" },
      { "ext": ["mp4", "mov", "webm"], "name": "Video", "contentTypes": ["public.mpeg-4", "com.apple.quicktime-movie", "org.webmproject.webm"], "role": "Viewer", "rank": "Alternate" },
      { "ext": ["mp3", "wav", "m4a", "ogg"], "name": "Audio", "contentTypes": ["public.mp3", "com.microsoft.waveform-audio", "com.apple.m4a-audio", "org.xiph.ogg-audio"], "role": "Viewer", "rank": "Alternate" },
      { "ext": ["py", "sh", "swift", "c", "h", "cpp", "cc", "hpp", "js", "rb", "php", "pl", "java"], "name": "Source code", "contentTypes": ["public.python-script", "public.shell-script", "public.swift-source", "public.c-source", "public.c-header", "public.c-plus-plus-source", "public.c-plus-plus-header", "com.netscape.javascript-source", "public.ruby-script", "public.php-script", "public.perl-script", "com.sun.java-source"], "role": "Editor", "rank": "Alternate" },
      { "ext": ["ts", "tsx", "jsx", "mjs", "cjs", "go", "rs", "kt", "scala", "cs", "lua", "r", "sql", "vue", "svelte", "css", "scss", "less", "proto", "graphql", "tf", "toml", "ini", "cfg", "conf"], "name": "Code and config", "role": "Editor", "rank": "Alternate" },
      { "ext": ["mmd", "mermaid", "drawio", "dio"], "name": "Diagram", "role": "Editor", "rank": "Alternate" }
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "hardenedRuntime": true,
      "signingIdentity": "-",
      "dmg": {
        "background": "dmg/background.tiff",
        "windowSize": { "width": 660, "height": 450 },
        "appPosition": { "x": 165, "y": 160 },
        "applicationFolderPosition": { "x": 495, "y": 160 }
      }
    },
    "shortDescription": "bnbloc desktop client",
    "longDescription": "The bnbloc shared web UI packaged with a supervised, embedded bridge connector to a local agent core."
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["bnbloc"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFQjBEMkREOUQ2MUVCMjIKUldRaTYyR2QzZEt3SHVaaGVIWTRNT0QzbmcvRHlpOHhsS25SUHA0ZWFnYjBQbzIzNlFsSFhPVWoK"
    }
  }
}
